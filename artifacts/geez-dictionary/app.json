{
  "expo": {
    "name": "የግዕዝ መዝገበ ቃላት",
    "slug": "geez-dictionary",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "geez-dictionary",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "package": "com.kaleabteshome.geezdictionary",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#4F46E5"
      }
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": ["expo-router"],
    "newArchEnabled": false,
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
